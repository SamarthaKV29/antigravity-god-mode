mcp_config.json
config.json
*.env
*.env.*
*.key
*.pem
*.pfx
*.pbtxt
*.pb
*.db
*.sqlite
*oauth*
*token*

# Local Workspace & Projects State
projects/
sidecars/
daemon/
installation_id
browserOnboardingStatus.txt
user_settings.pb

# Session Data & Runtime Stores
conversations/
brain/
code_tracker/
context_state/
annotations/
browser_recordings/
playground/
implicit/
knowledge/
crashes/
LayoutCache/

# Backup Files
*.bak
*.bak/
*.tar.gz
*.zip

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
node_modules/
.venv/
env/
venv/
